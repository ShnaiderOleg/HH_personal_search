# --- hh.ru ---
# Обычный браузерный User-Agent. Меняйте при блокировках.
HH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Опция: вход под своим аккаунтом (риск бана!). Формат: "name=value; name2=value2".
# Пусто = анонимный парсинг.
HH_SESSION_COOKIES=

# --- Поллинг ---
POLL_INTERVAL_MINUTES=120
REQUEST_DELAY_SECONDS=3.0
MAX_PAGES=3

# --- Telegram-уведомления ---
TG_BOT_TOKEN=
TG_CHAT_IDS=

# --- Email-дайджест (опционально) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- БД ---
DB_PATH=data/hh.db

